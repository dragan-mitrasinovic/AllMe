# Supply-chain protection, also applies to manual `npm install` / `npm update` (needs npm 11.10+).
# Skip versions published in the last 3 days; malicious releases are usually pulled by then.
# Need a fresher version once? `npm install pkg@x.y.z --min-release-age=0`
min-release-age=3
# No dependency needs its install script (esbuild ships prebuilt binaries; lmdb/msgpackr fall back to JS),
# so skipping them closes the most common way a compromised package runs code on install.
ignore-scripts=true
